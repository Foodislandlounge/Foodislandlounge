{
  "entities": {
    "MenuItem": {
      "title": "MenuItem",
      "description": "A food or drink item on the menu",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Name of the dish" },
        "description": { "type": "string", "description": "Description of the dish" },
        "price": { "type": "number", "description": "Price in FCFA" },
        "category": { "type": "string", "enum": ["Appetizer", "Main Course", "Dessert", "Drink", "Special"], "description": "Menu category" },
        "imageUrl": { "type": "string", "description": "URL of the dish image" },
        "isAvailable": { "type": "boolean", "description": "Whether the item is currently available" }
      },
      "required": ["name", "price", "category"]
    },
    "Order": {
      "title": "Order",
      "description": "A customer order",
      "type": "object",
      "properties": {
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "items": { 
          "type": "array",
          "description": "List of ordered items with quantities"
        },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "preparing", "completed", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerName", "items", "total"]
    },
    "Reservation": {
      "title": "Reservation",
      "description": "A table reservation",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "guests": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "date", "time", "guests"]
    }
  },
  "firestore": {
    "/menu": {
      "schema": "MenuItem",
      "description": "Collection of menu items"
    },
    "/orders": {
      "schema": "Order",
      "description": "Collection of customer orders"
    },
    "/reservations": {
      "schema": "Reservation",
      "description": "Collection of table reservations"
    }
  }
}
