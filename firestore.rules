rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'mbuamokako@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Menu Items
    function isValidMenuItem(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.price is number && data.price >= 0 &&
             data.category in ['Appetizer', 'Main Course', 'Dessert', 'Drink', 'Special'] &&
             (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 1000)) &&
             (!('isAvailable' in data) || (data.isAvailable is bool));
    }

    match /menu/{itemId} {
      allow read: if true; // Menu is public
      allow create: if isAdmin() && isValidMenuItem(request.resource.data);
      allow update: if isAdmin() && isValidMenuItem(request.resource.data);
      allow delete: if isAdmin();
    }

    // Orders
    function isValidOrder(data) {
      return data.customerName is string && data.customerName.size() > 0 &&
             data.total is number && data.total >= 0 &&
             data.status in ['pending', 'preparing', 'completed', 'cancelled'] &&
             data.items is list && data.items.size() > 0;
    }

    match /orders/{orderId} {
      allow create: if true; // Customers can place orders
      allow read: if isAdmin() || (isSignedIn() && request.auth.token.email == resource.data.customerEmail);
      allow update: if isAdmin() || (isSignedIn() && request.auth.token.email == resource.data.customerEmail && 
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
                      request.resource.data.status == 'cancelled' && resource.data.status == 'pending');
    }

    // Reservations
    function isValidReservation(data) {
      return data.name is string && data.name.size() > 0 &&
             data.email is string &&
             data.date is string &&
             data.time is string &&
             data.guests is number && data.guests > 0;
    }

    match /reservations/{resId} {
      allow create: if true; // Public can reserve
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Admins collection (managed via Firebase Console or special script)
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable via console
    }
  }
}
