rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAuthorized(data) {
      return data.get('adminPasscode', '') == '654493005';
    }

    function isAdmin(optionalData) {
      return isSignedIn() || (optionalData != null && isAuthorized(optionalData));
    }

    function canDelete(existingData) {
      return isSignedIn() || isAuthorized(existingData);
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Menu Items
    function isValidMenuItem(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.price is number && data.price >= 0 &&
             data.category in ['Food', 'Drinks'] &&
             (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 1000)) &&
             (!('isAvailable' in data) || (data.isAvailable is bool)) &&
             (!('adminPasscode' in data) || (data.adminPasscode is string));
    }

    match /menu/{itemId} {
      allow read: if true; // Menu is public
      allow create: if isAdmin(request.resource.data) && isValidMenuItem(request.resource.data);
      allow update: if isAdmin(request.resource.data) && isValidMenuItem(request.resource.data);
      allow delete: if canDelete(resource.data);
    }

    // Orders
    function isValidOrder(data) {
      return data.customerName is string && data.customerName.size() > 0 &&
             data.customerPhone is string &&
             data.customerLocation is string && data.customerLocation.size() > 0 &&
             data.total is number && data.total >= 0 &&
             data.status in ['pending', 'preparing', 'completed', 'cancelled'] &&
             data.items is list && data.items.size() > 0 &&
             (!('adminPasscode' in data) || (data.adminPasscode is string));
    }

    match /orders/{orderId} {
      allow create: if isValidOrder(request.resource.data);
      allow read: if isAdmin(null);
      allow list: if true; 
      allow update: if isAdmin(request.resource.data);
    }

    // Reservations
    function isValidReservation(data) {
      return data.name is string && data.name.size() > 0 &&
             data.phone is string &&
             data.date is string &&
             data.time is string &&
             data.guests is number && data.guests > 0 &&
             (!('adminPasscode' in data) || (data.adminPasscode is string));
    }

    match /reservations/{resId} {
      allow create: if true; // Public can reserve
      allow read, list: if true; // Workaround for restricted auth
      allow update, delete: if isAdmin(request.resource.data) || canDelete(resource.data);
    }

    // Admins collection (managed via Firebase Console or special script)
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable via console
    }
  }
}
